```
    <!-- Tabs -->
    <div class="tabs">
        <button class="tab active" onclick="showTab('log')">📅 Log Workout</button>
        <button class="tab" onclick="showTab('progress')">📈 Progress</button>
    </div>

    <!-- Log View -->
    <div id="logView">
        <!-- Add Exercise Card -->
        <div class="card">
            <h2>Add Exercise</h2>
            <div id="lastPerformance" class="last-performance hidden"></div>
            <div class="form-grid">
                <input type="text" id="exerciseName" placeholder="Exercise name (e.g., Bench Press)" oninput="checkLastPerformance()">
                <div class="input-row">
                    <input type="number" id="sets" placeholder="Sets" inputmode="numeric">
                    <input type="number" id="reps" placeholder="Reps" inputmode="numeric">
                    <input type="number" id="weight" placeholder="Weight (lbs)" inputmode="decimal">
                </div>
                <button class="btn-primary" onclick="addExercise()">➕ Add Exercise</button>
            </div>
        </div>

        <!-- Current Workout Card -->
        <div id="currentWorkoutCard" class="card hidden">
            <h2>Today's Workout</h2>
            <div id="currentWorkoutList" class="exercise-list"></div>
            <button class="btn-success" onclick="saveWorkout()" style="margin-top: 1rem;">✅ Save Workout</button>
        </div>

        <!-- Recent Workouts Card -->
        <div class="card">
            <h2>Recent Workouts</h2>
            <div id="workoutHistory"></div>
        </div>
    </div>

    <!-- Progress View -->
    <div id="progressView" class="hidden">
        <div class="card">
            <h2>Exercise Progress</h2>
            <div id="progressCharts"></div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
    let workouts = [];
    let currentWorkout = [];
    let charts = {};

    // Load data on start
    window.addEventListener('load', () => {
        loadWorkouts();
        renderWorkoutHistory();
    });

    function loadWorkouts() {
        const saved = localStorage.getItem('workouts');
        if (saved) {
            workouts = JSON.parse(saved);
        }
    }

    function saveWorkouts() {
        localStorage.setItem('workouts', JSON.stringify(workouts));
    }

    function showTab(tab) {
        // Update tab buttons
        document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
        event.target.classList.add('active');

        // Show/hide views
        if (tab === 'log') {
            document.getElementById('logView').classList.remove('hidden');
            document.getElementById('progressView').classList.add('hidden');
        } else {
            document.getElementById('logView').classList.add('hidden');
            document.getElementById('progressView').classList.remove('hidden');
            renderProgressCharts();
        }
    }

    function checkLastPerformance() {
        const exerciseName = document.getElementById('exerciseName').value.trim().toLowerCase();
        const lastPerfDiv = document.getElementById('lastPerformance');

        if (!exerciseName) {
            lastPerfDiv.classList.add('hidden');
            return;
        }

        for (let workout of workouts) {
            const exercise = workout.exercises.find(ex => ex.name.toLowerCase() === exerciseName);
            if (exercise) {
                const date = new Date(workout.date).toLocaleDateString();
                lastPerfDiv.innerHTML = `
                    <p>Last time: <span class="highlight">${exercise.sets} sets × ${exercise.reps} reps</span>
                    ${exercise.weight > 0 ? `<span class="highlight">@ ${exercise.weight} lbs</span>` : ''}
                    <span style="color: #64748b; margin-left: 0.5rem;">(${date})</span></p>
                `;
                lastPerfDiv.classList.remove('hidden');
                return;
            }
        }

        lastPerfDiv.classList.add('hidden');
    }

    function addExercise() {
        const name = document.getElementById('exerciseName').value.trim();
        const sets = parseInt(document.getElementById('sets').value);
        const reps = parseInt(document.getElementById('reps').value);
        const weight = parseFloat(document.getElementById('weight').value) || 0;

        if (!name || !sets || !reps) {
            alert('Please fill in exercise name, sets, and reps');
            return;
        }

        const exercise = {
            name,
            sets,
            reps,
            weight,
            id: Date.now()
        };

        currentWorkout.push(exercise);
        renderCurrentWorkout();

        // Clear inputs
        document.getElementById('exerciseName').value = '';
        document.getElementById('sets').value = '';
        document.getElementById('reps').value = '';
        document.getElementById('weight').value = '';
        document.getElementById('lastPerformance').classList.add('hidden');
    }

    function removeExercise(id) {
        currentWorkout = currentWorkout.filter(ex => ex.id !== id);
        renderCurrentWorkout();
    }

    function renderCurrentWorkout() {
        const card = document.getElementById('currentWorkoutCard');
        const list = document.getElementById('currentWorkoutList');

        if (currentWorkout.length === 0) {
            card.classList.add('hidden');
            return;
        }

        card.classList.remove('hidden');
        list.innerHTML = currentWorkout.map(ex => `
            <div class="exercise-item">
                <div>
                    <strong>${ex.name}</strong>
                    <small>${ex.sets} sets × ${ex.reps} reps${ex.weight > 0 ? ` @ ${ex.weight} lbs` : ''}</small>
                </div>
                <button class="btn-danger" onclick="removeExercise(${ex.id})">🗑️</button>
            </div>
        `).join('');
    }

    function saveWorkout() {
        if (currentWorkout.length === 0) return;

        const workout = {
            date: new Date().toISOString(),
            exercises: currentWorkout,
            id: Date.now()
        };

        workouts.unshift(workout);
        saveWorkouts();
        currentWorkout = [];
        renderCurrentWorkout();
        renderWorkoutHistory();
    }

    function deleteWorkout(id) {
        if (confirm('Delete this workout?')) {
            workouts = workouts.filter(w => w.id !== id);
            saveWorkouts();
            renderWorkoutHistory();
        }
    }

    function renderWorkoutHistory() {
        const container = document.getElementById('workoutHistory');

        if (workouts.length === 0) {
            container.innerHTML = '<div class="empty-state">No workouts logged yet. Start your first workout above!</div>';
            return;
        }

        container.innerHTML = workouts.slice(0, 5).map(workout => {
            const date = new Date(workout.date).toLocaleDateString('en-US', {
                weekday: 'short',
                month: 'short',
                day: 'numeric',
                year: 'numeric'
            });

            return `
                <div class="workout-item">
                    <div class="workout-header">
                        <div class="workout-date">${date}</div>
                        <button class="btn-danger" onclick="deleteWorkout(${workout.id})">🗑️</button>
                    </div>
                    <div class="workout-exercises">
                        ${workout.exercises.map(ex => `
                            <div class="workout-exercise">
                                • ${ex.name}: ${ex.sets}×${ex.reps}${ex.weight > 0 ? ` @ ${ex.weight} lbs` : ''}
                            </div>
                        `).join('')}
                    </div>
                </div>
            `;
        }).join('');
    }

    function renderProgressCharts() {
        const container = document.getElementById('progressCharts');
        
        // Get all unique exercise names
        const exerciseNames = [...new Set(workouts.flatMap(w => w.exercises.map(ex => ex.name)))].sort();

        if (exerciseNames.length === 0) {
            container.innerHTML = '<div class="empty-state">Log some workouts to see your progress!</div>';
            return;
        }

        container.innerHTML = '';

        exerciseNames.forEach(exerciseName => {
            const data = getProgressData(exerciseName);
            
            if (data.length < 2) return;

            const chartDiv = document.createElement('div');
            chartDiv.className = 'chart-container';
            chartDiv.innerHTML = `
                <div class="chart-title">${exerciseName}</div>
                <canvas id="chart-${exerciseName.replace(/\s/g, '-')}"></canvas>
            `;
            container.appendChild(chartDiv);

            // Destroy existing chart if it exists
            const chartId = `chart-${exerciseName.replace(/\s/g, '-')}`;
            if (charts[chartId]) {
                charts[chartId].destroy();
            }

            // Create new chart
            setTimeout(() => {
                const ctx = document.getElementById(chartId);
                if (ctx) {
                    charts[chartId] = new Chart(ctx, {
                        type: 'line',
                        data: {
                            labels: data.map(d => d.date),
                            datasets: [
                                {
                                    label: 'Total Volume',
                                    data: data.map(d => d.volume),
                                    borderColor: '#3b82f6',
                                    backgroundColor: 'rgba(59, 130, 246, 0.1)',
                                    tension: 0.3
                                },
                                ...(data[0].weight > 0 ? [{
                                    label: 'Weight (lbs)',
                                    data: data.map(d => d.weight),
                                    borderColor: '#a78bfa',
                                    backgroundColor: 'rgba(167, 139, 250, 0.1)',
                                    tension: 0.3
                                }] : [])
                            ]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: {
                                legend: {
                                    labels: {
                                        color: '#cbd5e1'
                                    }
                                }
                            },
                            scales: {
                                x: {
                                    ticks: { color: '#94a3b8' },
                                    grid: { color: '#374151' }
                                },
                                y: {
                                    ticks: { color: '#94a3b8' },
                                    grid: { color: '#374151' }
                                }
                            }
                        }
                    });
                }
            }, 100);
        });
    }

    function getProgressData(exerciseName) {
        const data = [];
        const normalizedName = exerciseName.toLowerCase();

        [...workouts].reverse().forEach(workout => {
            const exercise = workout.exercises.find(ex => ex.name.toLowerCase() === normalizedName);
            if (exercise) {
                data.push({
                    date: new Date(workout.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }),
                    volume: exercise.sets * exercise.reps * (exercise.weight || 1),
                    weight: exercise.weight,
                    reps: exercise.reps,
                    sets: exercise.sets
                });
            }
        });

        return data;
    }
</script>
